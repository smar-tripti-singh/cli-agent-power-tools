# ── Required ────────────────────────────────────────────────
# Slack App-Level Token (Socket Mode connection to Slack)
SLACK_APP_TOKEN=xapp-1-...

# Slack Bot Token (for posting messages to Slack)
SLACK_BOT_TOKEN=xoxb-...

# Secret used to sign JWTs (random 32+ char string)
RELAY_JWT_SECRET=change-me-to-a-long-random-secret

# Registration code shared with users to register their machine
RELAY_REGISTRATION_CODE=your-team-registration-code

# ── Optional ────────────────────────────────────────────────
# RELAY_PORT=8443
# RELAY_MAX_QUEUE_SIZE=20
# RELAY_QUEUE_TTL_HOURS=4
# RELAY_HEARTBEAT_INTERVAL_MS=30000
# LOG_LEVEL=info
