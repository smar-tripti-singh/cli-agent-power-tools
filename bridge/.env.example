# SmartBridge Configuration
# These values are set via `npm run setup`
# This file is for reference only.

# ── Slack ──────────────────────────────────────────────
# Get from: https://api.slack.com/apps → SmartBridge → OAuth & Permissions
# SLACK_BOT_TOKEN=xoxb-your-bot-token

# ── User ──────────────────────────────────────────────
# Your Slack user ID (find in Slack profile → ⋮ → Copy member ID)
# MY_USER_ID=U0123456789

# ── Settings ──────────────────────────────────────────
# POLL_INTERVAL_MS=10000
# JOB_TIMEOUT_MS=600000
